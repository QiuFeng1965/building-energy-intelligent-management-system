# 擎翼数字中枢 - 后端环境变量配置模板
# 复制此文件为 .env 并填入真实值，切勿将 .env 提交到 git

# ===== AI 大模型 API =====
AI_API_KEY=sk-your-siliconflow-api-key-here

# ===== RagFlow 知识库 =====
RAGFLOW_API_URL=http://192.168.244.1/api/v1
RAGFLOW_API_KEY=ragflow-your-ragflow-api-key-here
RAGFLOW_CHAT_ID=your-ragflow-chat-id-here

# ===== JWT 鉴权 =====
JWT_SECRET=your-random-jwt-secret-at-least-32-chars
ADMIN_USERNAME=admin
# 生成方式：python -c "import bcrypt;print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash-here

# ===== SMTP 邮件 =====
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
MANAGER_EMAIL=manager-email@qq.com

# ===== 前端源（CORS，支持逗号分隔多域名）=====
CORS_ORIGINS=http://localhost:5173
# 向后兼容旧变量名（CORS_ORIGINS 缺失时回退到此）
FRONTEND_ORIGIN=http://localhost:5173

# ===== 演示模式开关（1=启用硬编码劫持，0=走真实 LLM/RagFlow）=====
DEMO_MODE=0
